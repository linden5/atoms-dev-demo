# 验收脚本的地址配置模板：复制成 deploy/verify.env 后按实际环境填写。
# deploy/verify.env 已在 .gitignore 中，不会进仓库；换 IP / 换机器都不用改代码。
#
# 用法：
#   cp deploy/verify.env.example deploy/verify.env
#   bash scripts/verify_s1.sh                            # 本机，用 LOCAL_BASE_URL
#   TARGET=public bash scripts/verify_s1.sh              # 公网，用 PUBLIC_BASE_URL
#   BASE_URL=http://IP:8000 bash scripts/verify_s1.sh    # 临时指定，优先级最高
#
# 注意：公网地址请在外部机器（本地电脑、手机热点）上验证。
#      服务器访问自己的公网 IP 受 NAT 回环限制，超时属正常现象，不代表服务异常。

# 本机验收地址：服务器与本地开发机都用它
LOCAL_BASE_URL=http://127.0.0.1:8000

# 公网验收地址：取消注释并填入实际地址。
# 未配置时 TARGET=public 会直接报错退出，避免把公网验证悄悄跑成 localhost。
# PUBLIC_BASE_URL=http://<公网IP>:8000
