; S2 版本：uvicorn 单 worker 提供 /health + web/ 静态托管
; 单 worker 是硬性约束：S3 起任务队列与并发信号量都在进程内，多 worker 会导致状态不一致
[Unit]
Description=Atoms Demo
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/atoms-dev-demo
Environment=PYTHONUNBUFFERED=1
; 引擎选择（S8 起）：ENGINE_MODE=llm|mock|metagpt|auto，留空等同 auto
;   auto = LLM 三项配齐用 LLM → 能导入 MetaGPT 用 MetaGPT → 否则降级 MOCK
; 旧的 MOCK_ENGINE 三态仍然有效（MOCK_ENGINE=1 强制 MOCK，=0 强制 MetaGPT）
; Environment=ENGINE_MODE=llm
; Environment=LLM_BASE_URL=https://api.deepseek.com/v1
; Environment=LLM_MODEL=deepseek-chat
; Key 单独放 EnvironmentFile（权限 600），不要写在本文件里
; EnvironmentFile=/etc/atoms/llm.env
ExecStart=/home/ubuntu/atoms-dev-demo/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
