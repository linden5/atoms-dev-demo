; S2 版本：uvicorn 单 worker 提供 /health + web/ 静态托管
; 单 worker 是硬性约束：S3 起任务队列与并发信号量都在进程内，多 worker 会导致状态不一致
[Unit]
Description=Atoms Demo
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/atoms-dev-demo
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/atoms-dev-demo/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
